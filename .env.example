# Desarrollo local: usa el proxy de Vite (ver vite.config.js)
# El proxy reenvía /api/* a https://campored-backend-production.up.railway.app
VITE_API_BASE_URL=/api

# Producción en Vercel: apunta directamente al backend
# VITE_API_BASE_URL=https://campored-backend-production.up.railway.app/api
#
# Nota: en producción el backend debe tener habilitado CORS para el dominio
# del frontend. El proxy de Vite solo aplica en desarrollo local.
